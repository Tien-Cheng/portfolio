{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker: no `main`. Cloudflare serves the Astro build straight from ./dist.
  "name": "portfolio",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Astro builds /cv as cv.html (build.format "file"); serve it at /cv and redirect /cv/ to /cv.
    "html_handling": "drop-trailing-slash"
  },
  // Worker Previews need this block, even when empty. Previews run per pull request in CI.
  "previews": {}
  // No routes yet. tiencheng.dev is still attached to the old Pages project. After the domain
  // moves to this Worker in the dashboard, add:
  //   "routes": [{ "pattern": "tiencheng.dev", "custom_domain": true }]
}
