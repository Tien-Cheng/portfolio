---
import OrgRole from "../components/OrgRole.astro";
import Row from "../components/Row.astro";
import Section from "../components/Section.astro";
import { intro, projects, site } from "../data/site";
import Base from "../layouts/Base.astro";
import { formatSpan } from "../lib/dates";
import { degreeTitle, education, educationNote, experience } from "../lib/resume";

const current = experience.find((e) => e.end_date?.toLowerCase() === "present");

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: "Tien Cheng Oh",
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  jobTitle: current?.position ?? site.jobTitle,
  ...(current && { worksFor: { "@type": "Organization", name: current.company } }),
  address: { "@type": "PostalAddress", addressLocality: site.location },
  sameAs: [site.links.github, site.links.linkedin],
  alumniOf: education.map((e) => ({ "@type": "EducationalOrganization", name: e.institution })),
};

const contacts = [
  { label: "Email", href: `mailto:${site.email}` },
  { label: "GitHub", href: site.links.github },
  { label: "LinkedIn", href: site.links.linkedin },
  { label: "CV", href: "/cv" },
];
---

<Base jsonLd={person}>
  <h1 class="sr-only">{site.name}</h1>

  <section aria-label="Introduction" class="flex flex-col gap-5">
    <p class="text-pretty">{intro[0]}</p>
    <p class="text-pretty text-muted">{intro[1]}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-base text-muted">
      {contacts.map((c) => (
  <li>
    <a href={c.href}>{c.label}</a>
  </li>
))}
    </ul>
  </section>

  <Section label="Work">
    {experience.map((w) => (
  <Row aside={formatSpan(w)}>
    <p>
      <OrgRole org={w.company} role={w.position} />
    </p>
    {w.summary && <p class="text-base text-pretty text-muted">{w.summary}</p>}
  </Row>
))}
  </Section>

  <Section label="Projects">
    {projects.map((p) => {
  const external = /^https?:\/\//.test(p.href);
  return (
    <Row aside={p.year}>
      <p>
        <a href={p.href} class="font-semibold">
          {p.name}
          <span aria-hidden="true">{external ? " ↗" : " →"}</span>
        </a>
      </p>
      <p class="text-base text-pretty text-muted">{p.blurb}</p>
    </Row>
  );
})}
  </Section>

  <Section label="Education">
    {education.map((e) => (
  <Row aside={formatSpan(e)}>
    <p>
      <OrgRole org={e.institution} role={degreeTitle(e)} />
    </p>
    {e.highlights && <p class="text-base text-pretty text-muted">{educationNote(e)}</p>}
  </Row>
))}
  </Section>
</Base>
