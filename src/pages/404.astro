---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="There is no page at this address." noindex>
  <div class="flex flex-col gap-4">
    <h1 class="text-title font-semibold tracking-[-0.01em]">Page not found</h1>
    <p class="text-pretty text-muted">
      There's nothing at this address. It may have moved when the site was rebuilt.
    </p>
    <p class="text-base"><a href="/">Back to the index</a></p>
  </div>
</Base>
