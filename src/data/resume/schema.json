              "label": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "details"
            ],
            "additionalProperties": {}
          }
        },
        "Awards & Open Source": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bullet": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "bullet"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
