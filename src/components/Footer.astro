---
import meta from "../data/resume/meta.json";
import { site } from "../data/site";

const updated = new Date(`${meta.syncedAt}T00:00:00Z`).toLocaleDateString("en-GB", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<footer class="flex flex-wrap justify-between gap-4 border-t border-rule pt-6 text-sm text-faint">
  <span>{site.location}</span>
  <span>Updated {updated}</span>
</footer>
